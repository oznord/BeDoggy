{% extends 'base.html.twig' %}

{% block title %}Détail de la demande{% endblock %}

{% block body %}
    {% set prestation = demande.correspondre|first %}
    {% set statut = demande.statut ? demande.statut.libelle|lower : '' %}
    {% set statutClasse = statut|replace({' ': '-'}) %}

    <div class="demandes-page">
        <nav class="navbar demandes-navbar">
            <a class="demandes-logo" href="{{ path('app_accueil') }}">
                <img src="{{ asset('assets/images/Logo BeDoggy unique.png') }}" alt="BeDoggy">
            </a>
            <div class="demandes-navigation">
                <a class="is-active" href="{{ path('app_gerer_demande') }}">Mes demandes</a>
                <a href="{{ path('app_prestation') }}">Prestations</a>
                {% if app.user.role and app.user.role.id == 1 %}
                    <a href="{{ path('app_traiter_demande') }}">Administration</a>
                {% endif %}
            </div>
            <div class="demandes-actions" aria-label="Actions utilisateur">
                <span class="demandes-user-icon">{{ app.user.prenom|first }}</span>
                <a href="{{ path('app_logout') }}" class="demandes-logout" aria-label="Déconnexion">↪</a>
            </div>
        </nav>

        <main class="demandes-content demande-detail-content">
            <a class="demande-retour" href="{{ path('app_gerer_demande') }}">← Retour à mes demandes</a>
            <header class="demandes-header">
                <div>
                    <span class="demande-reference">REQ-{{ '%03d'|format(demande.id) }}</span>
                    <h1>{{ prestation ? prestation.libelle : 'Demande de prestation' }}</h1>
                    <p>Demandée le {{ demande.date ? demande.date|date('d/m/Y') : 'date inconnue' }}</p>
                </div>
                <span class="demande-statut statut-{{ statutClasse }}">
                    {{ demande.statut ? demande.statut.libelle : 'Statut inconnu' }}
                </span>
            </header>

            <section class="demande-detail-card">
                <div class="demande-detail-block">
                    <span class="demande-detail-label">DESCRIPTION DE VOTRE DEMANDE</span>
                    <p>{{ demande.description ?: 'Aucune description renseignée.' }}</p>
                </div>
                <div class="demande-detail-response">
                    <span class="demande-detail-label">RÉPONSE DE L'ADMINISTRATEUR</span>
                    {% if demande.reponse %}
                        <p>{{ demande.reponse }}</p>
                    {% else %}
                        <p class="demande-no-response">Votre demande n'a pas encore reçu de réponse.</p>
                    {% endif %}
                </div>
            </section>
        </main>
    </div>
{% endblock %}
