{% extends 'base.html.twig' %}

{% block title %} Accueil {% endblock %}

{% block body %}

    <div class="presentationAccueil">
        <!-- Haut de page -->
        <div class="titreFondAccueil">
            <img src="{{ asset('assets/images/petite feuille.png') }}" alt="feuille">
            <h3> Un soutien au quotidien pour nos compagnons </h3>
            <h1> Des services sur mesure pour le <span class="motVert"> bien-être </span> de votre chien </h1> 
            <p> BeDoggy accompagne les éleveurs canins et les propriétaires dans la gestion
            et le suivi de leurs demandes. Profitez de prestations professionnelles, 
            simples et rapides, pour le bonheur de vos chiens. </p>
            <div class="boutonsAccueil">
                <a class="bouton1" href="{{ path('app_prestation') }}">
                    <img src="{{ asset('assets/images/patte blanche.png')}}" alt="patteBlanche">
                    Découvrir nos prestations →
                </a>
                <form action="{{ app.user ? path('app_ajouter_demande') : path('app_inscription') }}">
                    <button class="bouton2">
                        <img src="{{ asset('assets/images/icone_blanc_transparent.png')}}" alt="iconeBlanc">
                        {{ app.user ? 'Créer une demande' : 'Créer un compte' }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Mise en confiance -->
    <div class="miseConfiance">
        <div class="cercle cercle1">
            <img src="{{ asset('assets/images/patte verte.png')}}" alt="patteVerte">
        </div>
        <h2 class="titre1"> Des prestations variées </h2>
        <p class="p1"> Soins, éducation, garde... des services adaptés à chaque besoin. </p>
        <div class="cercle cercle2">
            <img src="{{ asset('assets/images/bouclier vert.png')}}" alt="bouclierVert">
        </div>
        <h2 class="titre2"> Educateur de confiance </h2>
        <p class="p2"> Un éducateur passionné, reconnu pour son expertise et son sérieux. </p>
        <div class="cercle cercle3">
            <img src="{{ asset('assets/images/calendrier vert.png')}}" alt="calendrierVert">
        </div>
        <h2 class="titre3"> Une gestion simplifée </h2>
        <p class="p3"> Créez vos demandes en ligne et suivez-les en temps réel. </p>
        <div class="cercle cercle4">
            <img src="{{ asset('assets/images/coeur vert.png')}}" alt="coeurVert">
        </div>
        <h2 class="titre4"> Le bien-être avant tout </h2>
        <p class="p4"> Le respect et la santé de votre chien sont notre priorité. </p>
    </div>

    <!-- Titre des prestations -->
    <div class="introPresentationPrestas">
        <div class="titrePrestasAccueil">
            <img src="{{ asset('assets/images/petite feuille.png')}}" alt="petiteFeuille">
            <h3> NOS PRESTATIONS </h3>
            <h1> Des services adaptés à vos besoins </h1>
            <p> Découvrez nos différentes prestations et choisissez celle qui 
                correspond le mieux à votre demande. </p>
        </div>
        <div class="boutonVoirPrestas">
            <button> Voir toutes les prestations → </button>
        </div>
    </div>

    <!-- Affichage des 3 premières prestas -->
    <div class="accueilPrestas">
        {% for prestation in prestations %}
            <div class="chaquePrestaAccueil">
                <img src="{{ asset('assets/images/prestations/' ~ prestation.image)}}" alt="{{ prestation.libelle }}">
                <h3> {{ prestation.libelle }} </h3>
            </div>
        {%  endfor %}
    </div>


          
{% endblock %}
