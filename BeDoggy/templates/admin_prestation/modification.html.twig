{% extends 'base.html.twig' %}

{% block title %}Gestion des prestations{% endblock %}

{% block body %}
    <nav class="navbar">
        <div class="nav-left">
            <img src="{{ asset('assets/images/Logo BeDoggy unique.png') }}" alt="logo">
            <p> BeDoggy </p>
        </div>
        <div class="nav-center">
            <a href="{{ path('app_accueil') }}"> Accueil </a>
            <a href="{{ path('app_prestation') }}"> Prestations </a>
            <a href="{{ path('app_admin_prestation') }}"> AdminPrestations </a>

            <!-- ROUTES POUR APRES + RAJOUTER INFOS DANS PATH
            <a href=""> Créer une demande </a>
            <a href=""> Mes demandes </a>
            <a href=""> Connexion </a>
            -->
        </div>
        <div class="nav-right">
            <form action="{{ path('app_inscription') }}">
                <button>
                    <img src="{{ asset('assets/images/icone_blanc_transparent.png')}}" alt="iconeBlanc">
                    S'inscrire
                </button>
            </form>
        </div>
    </nav>

    <!-- Haut de page -->
    <div class="presentationPrestation">
        <div class="layoutHautPagePresta">
            <h2> Prestations </h2>
            <div class="traitBlanc"></div>
            <h1> Modification d'un prestation </h1>
        </div>
    </div>

    <!-- Modification des informations de la prestation -->
    <div class="backgroundModifPrestation">
        <h2> Modifier une prestation </h2>
        <div class="prestationAmodifier">
            <h3 class="image"> IMAGE </h3>
            <div class="choixImageModif">
                {% for image in images %}
                    <label class="imageDuChoix">
                        <input type="radio" name="image" value="{{ image }}">
                        <img src="{{ asset('assets/images/prestations/' ~ image) }}">
                    </label>
                {% endfor %}
            </div>

            <h3 class="libelle"> LIBELLE <span class="asterisque">*</span> </h3>
            <input class="inputLibelle" type="text" name="libelle" value="{{ prestation.libelle }}">

            <h3 class="description"> DESCRIPTION <span class="asterisque">*</span> </h3>
            <textarea class="longueTextbox" type="text" name="description">{{ prestation.description }}</textarea>

            <h3 class="nbSeance"> NOMBRE SEANCES </h3>
            <input class="inputNbSeance" type="number" name="nbSeance" value="{{ prestation.nbSeance }}">

            <h3 class="tempsSeance"> TEMPS SEANCE </h3>
            <input class="inputTempsSeance" type="number" name="tempsSeance" value="{{ prestation.tempsSeance }}">

            <h3 class="prixSeance"> PRIX SEANCE </h3>
            <input class="inputPrixSeance" type="number" name="prixSeance" value="{{ prestation.prixSeance }}">

            <button> Valider les modifications </button>
        </div>
    </div>

{% endblock %}
